{
  "name": "cor3-helper-unified",
  "version": "1.8.6",
  "private": true,
  "description": "COR3 Helper Unified (Firefox & Chrome MV3)",
  "cor3Fork": {
    "label": "unified",
    "build": 1
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "sync-versions": "node scripts/sync-versions.js",
    "sync-versions:check": "node scripts/sync-versions.js --check",
    "release:prepare": "npm run sync-versions && npm run build",
    "test": "node --test tests/*.test.mjs",
    "build:firefox": "npm run build && node scripts/build_firefox.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "npm": "^12.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
